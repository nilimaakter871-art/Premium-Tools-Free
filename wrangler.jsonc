{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "premium-tools-free",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
